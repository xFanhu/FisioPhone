<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_medium"
    android:layout_marginVertical="@dimen/spacing_small"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivTeamMemberPhoto"
            android:layout_width="@dimen/avatar_list_size"
            android:layout_height="@dimen/avatar_list_size"
            android:src="@drawable/ic_profile"
            app:tint="@color/azul"
            android:padding="@dimen/avatar_list_padding"
            android:background="#1A2196F3"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvTeamMemberName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/card_text"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                tools:text="Nombre Apellidos"/>

            <TextView
                android:id="@+id/tvTeamMemberEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/description_gray"
                android:textSize="@dimen/text_size_small"
                android:layout_marginTop="@dimen/spacing_micro"
                tools:text="email@example.com"/>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
